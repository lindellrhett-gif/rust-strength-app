# Copy to .env and fill in from your Supabase project settings (Project Settings -> API).
# Both are safe to expose in a client bundle (the anon key is protected by Row Level Security).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Rust Strength Pro (optional; see store/SUBSCRIPTIONS.md). RevenueCat's PUBLIC
# iOS SDK key (starts appl_), never the secret key. Subscriptions stay off
# unless EXPO_PUBLIC_SUBSCRIPTIONS is "on" and a paid feature exists.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_SUBSCRIPTIONS=
