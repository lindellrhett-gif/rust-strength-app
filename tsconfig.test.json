{
  // ts-jest compiles to CommonJS for Jest; the app itself still builds with the
  // ESM settings in tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "isolatedModules": false,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "types": ["jest", "node"]
  }
}
